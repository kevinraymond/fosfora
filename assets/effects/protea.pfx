{
    "name": "Protea",
    "author": "Fosfora",
    "description": "A mass-conserving Flow Lenia ecosystem — three species of amoebae with membranes and organelles that hunt, merge, and divide, fed by the music itself. Loudness is food (silence starves them until they shrink), bass swells their sensing kernels, onsets rain nutrient droplets, key changes mutate regional species, and strong beats thin the medium so the whole ecosystem surges.",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "sim_speed",     "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "kernel_radius", "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "growth_center", "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "growth_width",  "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "food",          "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "mutation",      "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "injection",     "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "viscosity",     "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "saturation",    "default": 0.55, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "brightness",    "default": 0.55, "min": 0.0, "max": 1.0 }
    ],
    "passes": [
        { "name": "potential", "shader": "protea_potential.wgsl", "scale": 0.5, "feedback": false, "prev_inputs": ["mass"] },
        { "name": "mass",      "shader": "protea_mass.wgsl",      "scale": 0.5, "feedback": true,  "inputs": ["potential"] },
        { "name": "display",   "shader": "protea_display.wgsl",   "scale": 1.0, "feedback": true,  "inputs": ["mass", "potential"] }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.6,
        "bloom_intensity": 0.35,
        "vignette": 0.25,
        "grain_enabled": false
    },
    "audio_mappings": [
        { "feature": "rms", "target": "food — mass grows where growth is favorable; silence starves the whole ecosystem" },
        { "feature": "bass", "target": "kernel radius — creatures swell on low end" },
        { "feature": "chroma", "target": "12-sector spatial growth modulation — key changes mutate regional species" },
        { "feature": "onset", "target": "nutrient droplets — mass rains in at jittered sites" },
        { "feature": "beat_strength", "target": "flow viscosity — the medium thins and creatures surge" },
        { "feature": "key_class", "target": "global palette tilt toward the detected key" }
    ]
}
