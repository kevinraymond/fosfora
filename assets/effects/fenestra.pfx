{
    "name": "Fenestra",
    "author": "Fosfora",
    "description": "GUI panels snapping into place across the bar — staggered brackets and scrims arriving with a white flash, settling into palette color, gone by the next cycle. Latin for “window”.",
    "category": "overlay",
    "alpha": true,
    "loop": "phase_locked",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "count",          "default": 12.0, "min": 1.0, "max": 24.0 },
        { "type": "Float", "name": "margin",         "default": 0.1,  "min": 0.0, "max": 0.3 },
        { "type": "Float", "name": "scrim",          "default": 0.15, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "flash",          "default": 0.7,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "snap",           "default": 0.85, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "seed",           "default": 0.0,  "min": 0.0, "max": 1000.0 },
        { "type": "Float", "name": "bars_per_cycle", "default": 4.0,  "min": 1.0, "max": 16.0 },
        { "type": "Color", "name": "tint",           "default": [0.8, 0.95, 1.0, 1.0] }
    ],
    "passes": [
        { "name": "main", "shader": "fenestra.wgsl", "feedback": false }
    ],
    "postprocess": {
        "bloom_threshold": 0.7,
        "bloom_intensity": 0.25,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    }
}
