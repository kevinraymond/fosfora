{
    "name": "Helix",
    "effect_type": "particle",
    "author": "Fosfora",
    "description": "The last eight seconds of audio swept into a twisting ribbon you fly along — the cross-section is the spectrum, the colour is the timbre, and every beat stays visible in the wall as it recedes.",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "radius",
            "default": 0.58,
            "min": 0.1,
            "max": 0.9
        },
        {
            "type": "Float",
            "name": "thickness",
            "default": 0.032,
            "min": 0.005,
            "max": 0.15
        },
        {
            "type": "Float",
            "name": "twist",
            "default": 2.4,
            "min": -8.0,
            "max": 8.0
        },
        {
            "type": "Float",
            "name": "spectrum",
            "default": 0.55,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "wander",
            "default": 0.3,
            "min": 0.0,
            "max": 0.8
        },
        {
            "type": "Float",
            "name": "ripple",
            "default": 0.05,
            "min": 0.0,
            "max": 0.2
        },
        {
            "type": "Float",
            "name": "depth",
            "default": 0.8,
            "min": -0.95,
            "max": 0.95
        },
        {
            "type": "Float",
            "name": "zoom",
            "default": 2.1,
            "min": 0.8,
            "max": 4.0
        },
        {
            "type": "Float",
            "name": "hue",
            "default": 0.6,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "timbre_hue",
            "default": 0.7,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "absorption",
            "default": 3.4,
            "min": 0.2,
            "max": 6.0
        },
        {
            "type": "Float",
            "name": "emission",
            "default": 0.42,
            "min": 0.0,
            "max": 3.0
        }
    ],
    "passes": [
        {
            "name": "bg",
            "shader": "helix_bg.wgsl",
            "feedback": false
        }
    ],
    "particles": {
        "render_mode": "billboard",
        "max_count": 1,
        "emitter": {
            "shape": "point",
            "radius": 0.0,
            "position": [
                0.0,
                0.0
            ]
        },
        "helix": {
            "grid_res": 128,
            "slice_count": 256,
            "slice_rate": 32.0,
            "twist_rate": 0.9,
            "wander_rate": 0.17,
            "look": {
                "detail_strength": 0.55,
                "detail_scale": 9.0,
                "density_threshold": 0.02,
                "cam_yaw": 0.0,
                "cam_pitch": 0.0,
                "march_steps": 96,
                "age_influence": 0.6
            }
        }
    }
}
