{
    "name": "Helix",
    "effect_type": "particle",
    "author": "Fosfora",
    "description": "The last eight seconds of audio swept into a twisting ribbon you fly along — the cross-section is the spectrum, the colour is the timbre, and every beat stays visible in the wall as it recedes.",
    "shader": "",
    "inputs": [],
    "passes": [
        {
            "name": "bg",
            "shader": "helix_bg.wgsl",
            "feedback": false
        }
    ],
    "particles": {
        "render_mode": "billboard",
        "max_count": 1,
        "emitter": {
            "shape": "point",
            "radius": 0.0,
            "position": [
                0.0,
                0.0
            ]
        },
        "helix": {
            "grid_res": 128,
            "slice_count": 256,
            "slice_rate": 32.0,
            "radius": 0.58,
            "thickness": 0.032,
            "twist_gain": 2.4,
            "twist_rate": 0.9,
            "spectrum_gain": 0.55,
            "wander": 0.30,
            "wander_rate": 0.17,
            "ripple_gain": 0.05,
            "hue_spread": 0.7,
            "look": {
                "palette_hue": 0.6,
                "absorption": 3.4,
                "emission_gain": 0.42,
                "detail_strength": 0.55,
                "detail_scale": 9.0,
                "density_threshold": 0.02,
                "fov": 2.1,
                "cam_distance": 0.80,
                "march_steps": 96,
                "age_influence": 0.6
            }
        }
    }
}
