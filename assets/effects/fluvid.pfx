{
    "name": "Fluvid",
    "author": "Fosfora",
    "description": "Fluid video: move in front of a camera and your motion stirs a real incompressible fluid, while a reaction-diffusion maze grows inside the ink it leaves. Medium morphs the liquid: ink, then mercury that mirrors you, then a water surface whose ripples echo every move. Place it above a webcam layer (it reads the layers beneath). The camera slider blends the picture back in. Motion size decides what counts: 0 inks every moving edge, 1 only solid patches of change (a mouth opening, not a swaying head). To limit it to one color or one area, put a Color Key or Mask node on the camera layer's chain.",
    "effect_type": "feedback",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "energy",        "default": 0.0,  "min": -1.0, "max": 1.0 },
        { "type": "Float", "name": "splat_force",   "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "motion_thresh", "default": 0.59, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "dye_amount",    "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "dissipation",   "default": 0.35, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "rd_scale",      "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "rd_rate",       "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "camera",        "default": 0.0,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "motion_size",   "default": 1.0,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "vorticity",     "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "hue",           "default": 0.85, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "camera_color",  "default": 0.2,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "gloss",         "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "audio",         "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "pattern",       "default": 0.8,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "medium",        "default": 0.0,  "min": 0.0, "max": 2.0 }
    ],
    "passes": [
        { "name": "cam",        "shader": "fluvid_cam.wgsl",      "scale": 0.25, "feedback": true,  "inputs": ["@backdrop"] },
        { "name": "motion",     "shader": "fluvid_motion.wgsl",   "scale": 0.25, "feedback": false, "inputs": ["cam"] },
        { "name": "wave",       "shader": "fluvid_wave.wgsl",     "scale": 0.5,  "feedback": true,  "iterations": 16, "inputs": ["motion"] },
        { "name": "divergence", "shader": "sumi_divergence.wgsl", "scale": 0.25, "feedback": false, "prev_inputs": ["velocity"] },
        { "name": "pressure",   "shader": "fluvid_pressure.wgsl",   "scale": 0.25, "feedback": true,  "iterations": 64, "inputs": ["divergence"] },
        { "name": "velocity",   "shader": "fluvid_velocity.wgsl", "scale": 0.25, "feedback": true,  "inputs": ["pressure", "motion"] },
        { "name": "rd",         "shader": "fluvid_rd.wgsl",       "scale": 0.25, "feedback": true,  "iterations": 32, "inputs": ["velocity", "motion"], "prev_inputs": ["dye"] },
        { "name": "dye",        "shader": "fluvid_dye.wgsl",      "scale": 0.5,  "feedback": true,  "inputs": ["velocity", "motion", "@backdrop"] },
        { "name": "display",    "shader": "fluvid_display.wgsl",  "scale": 1.0,  "feedback": false, "inputs": ["dye", "rd", "@backdrop", "wave"] }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.7,
        "bloom_intensity": 0.3,
        "vignette": 0.15,
        "grain_enabled": false
    },
    "audio_mappings": [
        { "feature": "onset", "target": "splat force and dye injection surge on each hit (scaled by audio)" },
        { "feature": "beat", "target": "a kick to every moving region's push" },
        { "feature": "bass", "target": "reaction-diffusion kill rate: the maze thickens and thins with the low end" },
        { "feature": "flux", "target": "vorticity confinement: sharper swirls on busy passages" },
        { "feature": "onset", "target": "ripple: each hit presses the water harder where you move" }
    ]
}
