{
    "name": "Iris",
    "author": "Fosfora",
    "description": "Spinning dot with fading feedback trails — circular pattern resembles an iris",
    "category": "pattern",
    "shader": "feedback_test.wgsl",
    "inputs": [
        {
            "type": "Float",
            "name": "trail_length",
            "default": 0.95,
            "min": 0.0,
            "max": 0.99
        },
        {
            "type": "Float",
            "name": "orbit_radius",
            "default": 0.3,
            "min": 0.05,
            "max": 0.6
        }
    ],
    "audio_mappings": [
        { "feature": "bass", "target": "orbit speed" },
        { "feature": "mid", "target": "orbit radius" },
        { "feature": "rms", "target": "dot size" },
        { "feature": "centroid", "target": "hue" },
        { "feature": "onset", "target": "brightness flash" }
    ]
}
