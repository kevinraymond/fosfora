{
    "name": "Reticle",
    "author": "Fosfora",
    "description": "Crosshairs acquiring targets: each reticle re-positions every bar and locks on with a contracting bracket keyed to the beat. Snap between targets or glide.",
    "category": "overlay",
    "alpha": true,
    "loop": "phase_locked",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "count",          "default": 3.0,  "min": 1.0, "max": 8.0 },
        { "type": "Float", "name": "size",           "default": 0.12, "min": 0.02, "max": 0.3 },
        { "type": "Bool",  "name": "snap_move",      "default": true },
        { "type": "Float", "name": "lock_flash",     "default": 0.6,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "seed",           "default": 0.0,  "min": 0.0, "max": 1000.0 },
        { "type": "Float", "name": "bars_per_cycle", "default": 4.0,  "min": 1.0, "max": 16.0 },
        { "type": "Color", "name": "tint",           "default": [1.0, 0.85, 0.6, 1.0] }
    ],
    "passes": [
        { "name": "main", "shader": "reticle.wgsl", "feedback": false }
    ],
    "postprocess": {
        "bloom_threshold": 0.7,
        "bloom_intensity": 0.25,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    }
}
