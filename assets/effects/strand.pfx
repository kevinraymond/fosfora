{
    "name": "Strand",
    "author": "Fosfora",
    "description": "Helices of hollow boxes drawn with no depth, so you cannot tell which way they turn and they flip as you watch; the drums put the depth back and lock the spin",
    "category": "illusion",
    "shader": "",
    "passes": [
        {
            "name": "state",
            "shader": "strand_state.wgsl",
            "scale": 0.03125,
            "feedback": true
        },
        {
            "name": "main",
            "shader": "strand.wgsl",
            "inputs": ["state"],
            "feedback": true
        }
    ],
    "inputs": [
        { "type": "Float", "name": "spin", "default": 0.12, "min": -1.0, "max": 1.0 },
        { "type": "Float", "name": "strands", "default": 3.0, "min": 0.0, "max": 6.0 },
        { "type": "Float", "name": "points", "default": 2.0, "min": 1.0, "max": 6.0 },
        { "type": "Float", "name": "twist", "default": 1.25, "min": 0.0, "max": 4.0 },
        { "type": "Float", "name": "rows", "default": 42.0, "min": 12.0, "max": 80.0 },
        { "type": "Float", "name": "box_size", "default": 0.62, "min": 0.3, "max": 0.95 },
        { "type": "Float", "name": "grid_snap", "default": 1.0, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "depth_cue", "default": 0.0, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "resolve", "default": 0.7, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "flip_bars", "default": 8.0, "min": 0.0, "max": 16.0 },
        { "type": "Float", "name": "reactivity", "default": 0.5, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "trail", "default": 0.35, "min": 0.0, "max": 0.99 }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.7,
        "bloom_intensity": 0.25,
        "vignette": 0.2,
        "ca_intensity": 0.0,
        "grain_enabled": false
    },
    "audio_mappings": [
        { "feature": "kick", "target": "depth cue (the kick resolves the spin)" },
        { "feature": "bass", "target": "spin speed, helix radius" },
        { "feature": "bar_index", "target": "spin reversal every flip_bars bars" }
    ]
}
