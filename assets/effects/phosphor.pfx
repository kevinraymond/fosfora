{
    "name": "Phosphor",
    "author": "Fosfora",
    "description": "Signature effect: intertwined teal and amber particle streams tracing a luminous P on black",
    "shader": "",
    "passes": [
        {
            "name": "velocity",
            "shader": "chronoflow_velocity.wgsl",
            "scale": 0.5,
            "feedback": true,
            "inputs": ["@particles.velocity"]
        },
        {
            "name": "history",
            "shader": "phosphor_history.wgsl",
            "feedback": true,
            "inputs": ["velocity"]
        }
    ],
    "inputs": [
        {
            "type": "Float",
            "name": "trail_decay",
            "default": 0.84,
            "min": 0.5,
            "max": 0.95
        },
        {
            "type": "Float",
            "name": "beat_snap",
            "default": 0.6,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "flow_stretch",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "particles": {
        "render_mode": "compute",
        "velocity_field": true,
        "max_count": 2000000,
        "compute_shader": "phosphor_sim.wgsl",
        "emitter": {
            "shape": "point",
            "radius": 0.55,
            "position": [0.0, 0.0]
        },
        "lifetime": 2.2,
        "initial_speed": 0.5,
        "initial_size": 0.007,
        "size_end": 0.002,
        "gravity": [0.0, 0.0],
        "drag": 0.997,
        "turbulence": 0.06,
        "attraction_strength": 0.0,
        "emit_rate": 200000.0,
        "burst_on_beat": 800,
        "size_curve": [1.0, 1.0, 0.85, 0.6, 0.35, 0.15, 0.05, 0.0],
        "opacity_curve": [0.8, 1.0, 1.0, 0.85, 0.6, 0.35, 0.15, 0.0]
    },
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.15,
        "bloom_intensity": 1.1,
        "vignette": 0.12
    },
    "hidden": true,
    "audio_mappings": [
        { "feature": "bass", "target": "curve amplitude" },
        { "feature": "rms", "target": "particle brightness + trail exposure" },
        { "feature": "onset", "target": "outward scatter" },
        { "feature": "beat", "target": "emission burst, inward pulse, shutter snap (trails go crisp)" }
    ]
}
