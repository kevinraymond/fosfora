{
    "name": "Limn",
    "author": "Fosfora",
    "description": "A living edge-tracer: outlines whatever plays on the layers beneath it, dashes marching along every contour in time with the bars. Layer it over anything — solo it sees nothing and draws nothing. Real transparency between the lines.",
    "category": "overlay",
    "alpha": true,
    "loop": "free",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "edge_gain",      "default": 2.5,  "min": 0.5, "max": 6.0 },
        { "type": "Float", "name": "thickness",      "default": 1.5,  "min": 0.5, "max": 4.0 },
        { "type": "Float", "name": "dash_density",   "default": 60.0, "min": 0.0, "max": 160.0 },
        { "type": "Bool",  "name": "inherit_color",  "default": true },
        { "type": "Float", "name": "glow",           "default": 0.35, "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "bars_per_cycle", "default": 4.0,  "min": 1.0, "max": 16.0 },
        { "type": "Color", "name": "tint",           "default": [0.85, 1.0, 0.95, 1.0] }
    ],
    "passes": [
        { "name": "main", "shader": "limn.wgsl", "inputs": ["@backdrop"], "feedback": false }
    ],
    "postprocess": {
        "bloom_threshold": 0.6,
        "bloom_intensity": 0.35,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    }
}
