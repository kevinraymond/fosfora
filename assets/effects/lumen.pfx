{
    "name": "Lumen",
    "author": "Fosfora",
    "description": "Real-time global illumination by radiance cascades — a swarm of coloured fireflies lights a soft breathing silhouette, and every light casts long soft-edged shadows with physically plausible penumbras. Each firefly takes the hue of a pitch class and flares with that note's energy, kicks pulse the whole room, bass swells the dancer, and tonal passages thicken the air into volumetric god-rays.",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "motion",        "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "light_count",   "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "emitter_glow",  "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "bounce",        "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "occluder_size", "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "fog",           "default": 0.2,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "reach",         "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "warmth",        "default": 0.5,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "saturation",    "default": 0.6,  "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "brightness",    "default": 0.55, "min": 0.0, "max": 1.0 }
    ],
    "passes": [
        { "name": "scene",    "shader": "lumen_scene.wgsl",   "scale": 0.5,      "feedback": true },
        { "name": "cascade5", "shader": "lumen_cascade.wgsl",  "scale": 0.015625, "feedback": true, "inputs": ["scene", "scene"] },
        { "name": "cascade4", "shader": "lumen_cascade.wgsl",  "scale": 0.03125,  "feedback": true, "inputs": ["scene", "cascade5"] },
        { "name": "cascade3", "shader": "lumen_cascade.wgsl",  "scale": 0.0625,   "feedback": true, "inputs": ["scene", "cascade4"] },
        { "name": "cascade2", "shader": "lumen_cascade.wgsl",  "scale": 0.125,    "feedback": true, "inputs": ["scene", "cascade3"] },
        { "name": "cascade1", "shader": "lumen_cascade.wgsl",  "scale": 0.25,     "feedback": true, "inputs": ["scene", "cascade2"] },
        { "name": "cascade0", "shader": "lumen_cascade.wgsl",  "scale": 0.5,      "feedback": true, "inputs": ["scene", "cascade1"] },
        { "name": "display",  "shader": "lumen_display.wgsl",  "scale": 1.0,      "feedback": true, "inputs": ["cascade0", "scene"] }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.6,
        "bloom_intensity": 0.35,
        "vignette": 0.25,
        "grain_enabled": false
    },
    "audio_mappings": [
        { "feature": "onset", "target": "fireflies flash — every light sparks on transients" },
        { "feature": "kick", "target": "global light pulse — the whole room brightens on the kick" },
        { "feature": "chroma", "target": "per-firefly colour + brightness (each light is a pitch class; loud notes light up)" },
        { "feature": "key_class", "target": "palette tilt toward the detected key" },
        { "feature": "bass", "target": "occluder size — the silhouette swells on low end" },
        { "feature": "brilliance", "target": "bounce boost — brighter bounced light" },
        { "feature": "flatness", "target": "fog density in the radiance march — tonal passages become volumetric god-rays" },
        { "feature": "beat_strength", "target": "firefly motion surge" }
    ]
}
