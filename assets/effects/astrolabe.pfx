{
    "name": "Astrolabe",
    "author": "Fosfora",
    "description": "A full-frame targeting instrument that assembles ring by ring across the cycle — degree ticks, counter-rotating sweep arms, orbiting target diamonds — with a center lock that slams on every downbeat. The set-piece overlay.",
    "category": "overlay",
    "alpha": true,
    "loop": "phase_locked",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "rings",
            "default": 4.0,
            "min": 2.0,
            "max": 6.0
        },
        {
            "type": "Float",
            "name": "size",
            "default": 0.5,
            "min": 0.2,
            "max": 0.6
        },
        {
            "type": "Float",
            "name": "detail",
            "default": 0.75,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "lock_strength",
            "default": 0.8,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "seed",
            "default": 0.0,
            "min": 0.0,
            "max": 1000.0
        },
        {
            "type": "Float",
            "name": "bars_per_cycle",
            "default": 8.0,
            "min": 1.0,
            "max": 16.0
        },
        {
            "type": "Color",
            "name": "tint",
            "default": [
                0.75,
                0.95,
                1.0,
                1.0
            ]
        }
    ],
    "passes": [
        {
            "name": "main",
            "shader": "astrolabe.wgsl",
            "feedback": false
        }
    ],
    "postprocess": {
        "bloom_threshold": 0.65,
        "bloom_intensity": 0.4,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    }
}
