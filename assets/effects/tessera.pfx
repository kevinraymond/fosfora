{
    "name": "Tessera",
    "author": "Fosfora",
    "description": "A grid of tiles revealing in beat-locked waves — hash scatter, row sweep, or center-out. In punch mode a dark scrim covers the frame and revealed tiles knock through it with real transparency, uncovering whatever you layer it over.",
    "category": "overlay",
    "alpha": true,
    "loop": "phase_locked",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "cols",
            "default": 24.0,
            "min": 4.0,
            "max": 64.0
        },
        {
            "type": "Float",
            "name": "rows",
            "default": 12.0,
            "min": 4.0,
            "max": 48.0
        },
        {
            "type": "Float",
            "name": "softness",
            "default": 0.15,
            "min": 0.0,
            "max": 0.5
        },
        {
            "type": "Float",
            "name": "scan_mode",
            "default": 2.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Bool",
            "name": "punch",
            "default": true
        },
        {
            "type": "Float",
            "name": "stroke",
            "default": 0.085,
            "min": 0.0,
            "max": 0.2
        },
        {
            "type": "Float",
            "name": "scrim",
            "default": 0.85,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "seed",
            "default": 0.0,
            "min": 0.0,
            "max": 1000.0
        },
        {
            "type": "Float",
            "name": "bars_per_cycle",
            "default": 4.0,
            "min": 1.0,
            "max": 16.0
        },
        {
            "type": "Color",
            "name": "tint",
            "default": [
                0.7,
                0.85,
                1.0,
                1.0
            ]
        }
    ],
    "passes": [
        {
            "name": "main",
            "shader": "tessera.wgsl",
            "feedback": false
        }
    ],
    "postprocess": {
        "bloom_threshold": 0.7,
        "bloom_intensity": 0.35,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    }
}
