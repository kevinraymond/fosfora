{
    "name": "Pegboard",
    "author": "Fosfora",
    "description": "Your image re-made as a backlit peg toy — samples snap to a square lattice, an ordered dither decides which holes carry a peg, colour quantizes to an eight-peg tray, and kicks shower pegs out of the board",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "peg_rows",
            "default": 64.0,
            "min": 24.0,
            "max": 96.0
        },
        {
            "type": "Float",
            "name": "peg_fill",
            "default": 0.86,
            "min": 0.3,
            "max": 1.2
        },
        {
            "type": "Float",
            "name": "tray_strength",
            "default": 1.0,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "dither_amount",
            "default": 0.7,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "peg_threshold",
            "default": 0.45,
            "min": 0.1,
            "max": 0.9
        },
        {
            "type": "Float",
            "name": "backlight",
            "default": 1.0,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "pop_force",
            "default": 0.45,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "polarity",
            "default": 1.0,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "passes": [
        {
            "name": "background",
            "shader": "pegboard_bg.wgsl",
            "feedback": false
        }
    ],
    "particles": {
        "render_mode": "billboard",
        "max_count": 30000,
        "compute_shader": "pegboard_sim.wgsl",
        "emitter": {
            "shape": "image",
            "radius": 1.0,
            "position": [0.0, 0.0],
            "image": "raster_phoenix.png"
        },
        "lifetime": 999.0,
        "initial_speed": 0.0,
        "initial_size": 0.008,
        "size_end": 0.008,
        "gravity": [0.0, 0.0],
        "drag": 1.0,
        "turbulence": 0.0,
        "attraction_strength": 0.0,
        "emit_rate": 60000.0,
        "burst_on_beat": 0,
        "blend": "alpha",
        "image_sample": {
            "mode": "grid",
            "scale": 1.0
        }
    },
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.6,
        "bloom_intensity": 0.35,
        "vignette": 0.35
    },
    "audio_mappings": [
        { "feature": "bass", "target": "lamp brightness behind the board" },
        { "feature": "brilliance", "target": "dither spread — shading shimmer" },
        { "feature": "beat", "target": "pops a subset of pegs out of their holes" },
        { "feature": "kick", "target": "fraction of the board that pops, and how hard" }
    ]
}
