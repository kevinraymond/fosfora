{
    "name": "Etch",
    "author": "Fosfora",
    "description": "Your image scratched into aluminium powder one stroke at a time — the stylus zigzags along a handful of scan lines, swinging wide where the picture is dark, then the board is shaken clean and it starts over. Pull Clear cycle to zero to hold the board blank",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "scan_rows",
            "default": 56.0,
            "min": 20.0,
            "max": 140.0
        },
        {
            "type": "Float",
            "name": "draw_rate",
            "default": 0.22,
            "min": 0.02,
            "max": 1.2
        },
        {
            "type": "Float",
            "name": "scribble_gain",
            "default": 0.8,
            "min": 0.0,
            "max": 1.5
        },
        {
            "type": "Float",
            "name": "polarity",
            "default": 1.0,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "line_weight",
            "default": 1.0,
            "min": 0.4,
            "max": 3.0
        },
        {
            "type": "Float",
            "name": "ink",
            "default": 0.9,
            "min": 0.1,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "clear_cycle",
            "default": 12.0,
            "min": 0.0,
            "max": 45.0
        },
        {
            "type": "Float",
            "name": "tone_floor",
            "default": 0.27,
            "min": 0.0,
            "max": 0.8
        }
    ],
    "passes": [
        {
            "name": "background",
            "shader": "etch_bg.wgsl",
            "feedback": true
        }
    ],
    "particles": {
        "render_mode": "billboard",
        "max_count": 90000,
        "compute_shader": "etch_sim.wgsl",
        "emitter": {
            "shape": "image",
            "radius": 1.0,
            "position": [0.0, 0.0],
            "image": "raster_samurai_mask.png"
        },
        "lifetime": 999.0,
        "initial_speed": 0.0,
        "initial_size": 0.0022,
        "size_end": 0.0022,
        "gravity": [0.0, 0.0],
        "drag": 1.0,
        "turbulence": 0.0,
        "attraction_strength": 0.0,
        "emit_rate": 200000.0,
        "burst_on_beat": 0,
        "blend": "alpha",
        "image_sample": {
            "mode": "grid",
            "scale": 1.0
        }
    },
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.95,
        "bloom_intensity": 0.05,
        "vignette": 0.4
    },
    "audio_mappings": [
        { "feature": "rms", "target": "how fast the stylus advances" },
        { "feature": "onset", "target": "extra pen speed on transients" },
        { "feature": "kick", "target": "pen rattle" },
        { "feature": "percussive_energy", "target": "sustained pen rattle" },
        { "feature": "drop", "target": "shakes the board clean early, on top of the clear cycle" }
    ]
}
