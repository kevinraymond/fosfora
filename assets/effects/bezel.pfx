{
    "name": "Bezel",
    "author": "Fosfora",
    "description": "Border chrome: corner brackets, edge rules, tick marks and drifting scanlines hugging the frame, with a subtle pulse on the beat — the always-on overlay that makes whatever sits beneath it read as instrumentation.",
    "category": "overlay",
    "alpha": true,
    "loop": "phase_locked",
    "shader": "",
    "inputs": [
        { "type": "Float", "name": "thickness",      "default": 0.01,  "min": 0.002, "max": 0.05 },
        { "type": "Float", "name": "corner",         "default": 0.12,  "min": 0.02, "max": 0.3 },
        { "type": "Float", "name": "ticks",          "default": 24.0,  "min": 0.0, "max": 64.0 },
        { "type": "Float", "name": "scanline_alpha", "default": 0.12,  "min": 0.0, "max": 0.5 },
        { "type": "Float", "name": "pulse",          "default": 0.3,   "min": 0.0, "max": 1.0 },
        { "type": "Float", "name": "seed",           "default": 0.0,   "min": 0.0, "max": 1000.0 },
        { "type": "Float", "name": "bars_per_cycle", "default": 4.0,   "min": 1.0, "max": 16.0 },
        { "type": "Color", "name": "tint",           "default": [0.7, 1.0, 0.9, 1.0] }
    ],
    "passes": [
        { "name": "main", "shader": "bezel.wgsl", "feedback": false }
    ],
    "postprocess": {
        "bloom_threshold": 0.7,
        "bloom_intensity": 0.25,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    }
}
