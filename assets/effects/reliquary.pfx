{
    "name": "Reliquary",
    "author": "Fosfora",
    "description": "A form that holds light \u2014 the surface stays put while the light escaping it streams outward, fades and returns. Point it at a model lit from inside and the shafts leaving the openings are made of moving particles",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "trail_decay",
            "default": 0.68,
            "min": 0.0,
            "max": 0.95
        },
        {
            "type": "Float",
            "name": "stream_speed",
            "default": 1.05,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "stream_length",
            "default": 0.28,
            "min": 0.0,
            "max": 0.6
        },
        {
            "type": "Float",
            "name": "shaft_gain",
            "default": 3.4,
            "min": 0.0,
            "max": 4.0
        },
        {
            "type": "Float",
            "name": "shed",
            "default": 0.3,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "body_spring",
            "default": 10.0,
            "min": 2.0,
            "max": 30.0
        },
        {
            "type": "Float",
            "name": "surge",
            "default": 1.35,
            "min": 0.0,
            "max": 2.0
        },
        {
            "type": "Float",
            "name": "bass_swell",
            "default": 0.38,
            "min": 0.0,
            "max": 0.6
        }
    ],
    "passes": [
        {
            "name": "background",
            "shader": "raster_bg.wgsl",
            "feedback": true
        }
    ],
    "particles": {
        "composite_decay": {
            "param": 0,
            "input": "trail_decay"
        },
        "render_mode": "compute",
        "max_count": 2000000,
        "compute_shader": "reliquary_sim.wgsl",
        "emitter": {
            "shape": "image",
            "radius": 1.0,
            "position": [
                0.0,
                0.0
            ],
            "image": "raster_phoenix.png"
        },
        "lifetime": 999.0,
        "initial_speed": 0.0,
        "initial_size": 0.002,
        "size_end": 0.002,
        "gravity": [
            0.0,
            0.0
        ],
        "drag": 0.98,
        "turbulence": 0.0,
        "attraction_strength": 0.0,
        "emit_rate": 100000.0,
        "burst_on_beat": 0,
        "blend": "additive",
        "image_sample": {
            "mode": "grid",
            "scale": 1.0
        },
        "model_sample": {
            "light_mix": 1.0,
            "ambient": 0.05,
            "ray_strength": 0.5
        }
    },
    "postprocess": {
        "bloom_threshold": 0.6,
        "bloom_intensity": 0.4
    }
}
