{
    "name": "Flux",
    "author": "Fosfora",
    "description": "Organic smoke — particles follow 3D curl noise flow field with audio-reactive turbulence",
    "shader": "",
    "inputs": [
        {
            "type": "Float",
            "name": "trail_decay",
            "default": 0.88,
            "min": 0.8,
            "max": 0.93
        },
        {
            "type": "Float",
            "name": "flow_intensity",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "color_shift",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "density",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "beat_snap",
            "default": 0.25,
            "min": 0.0,
            "max": 1.0
        },
        {
            "type": "Float",
            "name": "flow_stretch",
            "default": 0.3,
            "min": 0.0,
            "max": 1.0
        }
    ],
    "passes": [
        {
            "name": "background",
            "shader": "flux_bg.wgsl",
            "feedback": false
        },
        {
            "name": "velocity",
            "shader": "chronoflow_velocity.wgsl",
            "scale": 0.5,
            "feedback": true,
            "inputs": ["@particles.velocity"]
        },
        {
            "name": "history",
            "shader": "flux_history.wgsl",
            "feedback": true,
            "inputs": ["velocity", "background"]
        }
    ],
    "particles": {
        "render_mode": "compute",
        "velocity_field": true,
        "max_count": 2000000,
        "compute_shader": "flux_sim.wgsl",
        "emitter": {
            "shape": "screen",
            "radius": 1.0,
            "position": [0.0, 0.0]
        },
        "lifetime": 16.0,
        "initial_speed": 0.05,
        "initial_size": 0.008,
        "size_end": 0.003,
        "gravity": [0.0, 0.0],
        "drag": 0.995,
        "turbulence": 0.0,
        "attraction_strength": 0.0,
        "emit_rate": 200000.0,
        "burst_on_beat": 200,
        "flow_field": true,
        "flow_strength": 1.5,
        "flow_scale": 1.0,
        "flow_speed": 0.5
    },
    "postprocess": {
        "enabled": true,
        "bloom_threshold": 0.5,
        "bloom_intensity": 0.5,
        "vignette": 0.4
    },
    "audio_mappings": [
        { "feature": "bass", "target": "flow field strength" },
        { "feature": "mid", "target": "particle speed, color warmth" },
        { "feature": "onset", "target": "burst emission, radial push" },
        { "feature": "beat", "target": "flow field speed change, burst, shutter snap (trails go crisp)" },
        { "feature": "centroid", "target": "color hue (secondary warmth)" },
        { "feature": "rms", "target": "brightness, size" },
        { "feature": "mfcc[1]", "target": "curl strength (bright timbre = tight spirals, dark = loose)" },
        { "feature": "flux", "target": "turbulence speed and intensity (spectral change = spatial agitation)" },
        { "feature": "dominant_chroma", "target": "emission + background hue anchor (musical key → color)" }
    ]
}
