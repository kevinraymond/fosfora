{
    "name": "Plateau",
    "author": "Fosfora",
    "description": "The motion aftereffect: a spiral turns while the kick plays and stops dead when a breakdown takes it away, and the still picture seems to flow backward on its own",
    "category": "illusion",
    "shader": "",
    "passes": [
        {
            "name": "state",
            "shader": "plateau_state.wgsl",
            "scale": 0.03125,
            "feedback": true
        },
        {
            "name": "main",
            "shader": "plateau.wgsl",
            "inputs": ["state"],
            "feedback": false
        }
    ],
    "inputs": [
        { "type": "Float", "name": "pattern", "default": 0.0, "min": 0.0, "max": 2.0 },
        { "type": "Float", "name": "speed", "default": 0.5, "min": -2.0, "max": 2.0 },
        { "type": "Float", "name": "arms", "default": 3.0, "min": 1.0, "max": 12.0 },
        { "type": "Float", "name": "density", "default": 2.5, "min": 0.5, "max": 8.0 },
        { "type": "Float", "name": "contrast", "default": 1.0, "min": 0.0, "max": 1.0 },
        { "type": "Bool", "name": "follow_kick", "default": true },
        { "type": "Bool", "name": "tempo_lock", "default": false },
        { "type": "Bool", "name": "fixation", "default": true },
        { "type": "Bool", "name": "drift", "default": true }
    ],
    "postprocess": {
        "enabled": true,
        "bloom_enabled": false,
        "ca_enabled": false,
        "vignette_enabled": false,
        "grain_enabled": false,
        "tonemap": "linear"
    },
    "audio_mappings": [
        { "feature": "kick", "target": "drift runs while the kick plays, freezes in breakdowns" },
        { "feature": "bpm", "target": "drift speed (tempo_lock)" }
    ]
}
