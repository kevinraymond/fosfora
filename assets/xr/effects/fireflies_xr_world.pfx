{
  "name": "Fireflies",
  "author": "Fosfora",
  "description": "The Quest build's world effect: a sparse layer of soft points of light drifting slowly around the wearer, each glowing and fading on its own rhythm and swelling a little with the music, and the particles a hand throws, which arc, fall and run along the room's edges; drawn by the world-space sprite path (Quest build, debug.fosfora.mode world)",
  "category": "life",
  "shader": "",
  "inputs": [],
  "passes": [
    {
      "name": "background",
      "shader": "flux_bg.wgsl",
      "feedback": false
    }
  ],
  "particles": {
    "render_mode": "billboard",
    "velocity_field": false,
    "max_count": 20000,
    "compute_shader": "../xr/shaders/fireflies_xr_sim.wgsl",
    "emitter": {
      "shape": "screen",
      "radius": 3.0,
      "position": [
        0.0,
        0.0
      ]
    },
    "lifetime": 6.0,
    "initial_speed": 0.05,
    "initial_size": 0.01,
    "size_end": 0.004,
    "gravity": [
      0.0,
      0.0
    ],
    "drag": 0.99,
    "turbulence": 0.0,
    "attraction_strength": 0.0,
    "emit_rate": 4000.0,
    "burst_on_beat": 0,
    "flow_field": false
  },
  "postprocess": {
    "enabled": false,
    "bloom_threshold": 0.5,
    "bloom_intensity": 0.5,
    "vignette": 0.4
  },
  "audio_mappings": [
    {
      "feature": "rms",
      "target": "the fireflies' light and size, a hand particle's size"
    },
    {
      "feature": "dominant_chroma",
      "target": "a hand particle's hue anchor (musical key → color)"
    },
    {
      "feature": "centroid",
      "target": "a hand particle's hue (secondary warmth)"
    }
  ],
  "hidden": true
}
