{
  "name": "Flux XR Room",
  "author": "Fosfora",
  "description": "XR world-space variant of Flux whose embers are born on the room's surfaces: the desk sheds them on the beat and they slide off its edge onto the floor, the floor sparks with the bass; same sim and volume as Flux XR World (Quest build, debug.fosfora.mode world)",
  "category": "fluid",
  "shader": "",
  "inputs": [
    {
      "type": "Float",
      "name": "trail_decay",
      "default": 0.88,
      "min": 0.8,
      "max": 0.93
    },
    {
      "type": "Float",
      "name": "flow_intensity",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "color_shift",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "density",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "beat_snap",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "flow_stretch",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0
    },
    {
      "type": "Float",
      "name": "surface_emit",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "passes": [
    {
      "name": "background",
      "shader": "flux_bg.wgsl",
      "feedback": false
    }
  ],
  "particles": {
    "render_mode": "billboard",
    "velocity_field": false,
    "max_count": 400000,
    "compute_shader": "../xr/shaders/flux_xr_sim.wgsl",
    "emitter": {
      "shape": "screen",
      "radius": 1.5,
      "position": [
        0.0,
        0.0
      ]
    },
    "lifetime": 12.0,
    "initial_speed": 0.05,
    "initial_size": 0.005,
    "size_end": 0.002,
    "gravity": [
      0.0,
      0.0
    ],
    "drag": 0.98,
    "turbulence": 0.0,
    "attraction_strength": 0.0,
    "emit_rate": 160000.0,
    "burst_on_beat": 200,
    "flow_field": true,
    "flow_strength": 0.1,
    "flow_scale": 1.0,
    "flow_speed": 0.5
  },
  "postprocess": {
    "enabled": false,
    "bloom_threshold": 0.5,
    "bloom_intensity": 0.5,
    "vignette": 0.4
  },
  "audio_mappings": [
    {
      "feature": "bass",
      "target": "flow field strength"
    },
    {
      "feature": "mid",
      "target": "particle speed, color warmth"
    },
    {
      "feature": "onset",
      "target": "burst emission, radial push"
    },
    {
      "feature": "beat",
      "target": "flow field speed change, burst, size pulse"
    },
    {
      "feature": "centroid",
      "target": "color hue (secondary warmth)"
    },
    {
      "feature": "rms",
      "target": "brightness, size"
    },
    {
      "feature": "mfcc[1]",
      "target": "curl strength (bright timbre = tight spirals, dark = loose)"
    },
    {
      "feature": "flux",
      "target": "turbulence speed and intensity (spectral change = spatial agitation)"
    },
    {
      "feature": "dominant_chroma",
      "target": "emission hue anchor (musical key \u2192 color)"
    }
  ],
  "hidden": true
}
