{
 "model": {
  "onnx": "model_int8.onnx (embedding-only INT8; blocks and heads FP32)",
  "inputs": [
   "prefix_ids int64 [q, L]",
   "prefix_mask bool [q, L]",
   "doc_ids int64 [n, W]",
   "doc_mask bool [n, W]",
   "owners int64 [n]"
  ],
  "output": "logits float [n, 3]; columns choice, noul, score; softmax over a decision's candidates",
  "tokenizer": [
   "tokenizer.json",
   "tokenizer_config.json"
  ],
  "special_ids": {
   "cls": 50281,
   "sep": 50282,
   "pad": 50283
  },
  "query_length": 512,
  "document_length": 64,
  "query_truncation": "balanced"
 },
 "rendering": {
  "layout": "instruction_state (the model was trained on both orders 1:1; use this one)",
  "prefix": "[CLS] + enc(system + '\\n\\n' if system) + enc('Instruction: ' + instruction) + enc('\\n') + enc('State: ' + state) + [SEP]; each part tokenized separately, no special tokens; system is empty here",
  "noul_state": "for the request decision the state is json.dumps({'noul': {'yes': YES, 'no': NO}, 'state': <state object>}, separators=(',', ':'))",
  "candidate": "enc('Candidate: ' + id + ': ' + text) + [SEP]",
  "state": "json.dumps({'sentence', 'pointed' (a surface name or 'nothing'), 'effect', 'effects', 'surfaces': {name: behavior or 'behavior, color'}}) with Python's default separators (', ', ': ')",
  "state_example": {
   "sentence": "Table 14 in amber.",
   "pointed": "table 3",
   "effect": "Flux Cloud",
   "effects": [
    "Flux Cloud",
    "Embers",
    "Flock"
   ],
   "surfaces": {
    "table 0": "streamlines",
    "shelf 1": "curls",
    "wall 2": "spectrum",
    "table 3": "streamlines",
    "shelf 4": "curls",
    "wall 5": "spectrum",
    "table 6": "streamlines",
    "floor": "rings",
    "window": "pulse",
    "shelf 9": "curls",
    "ceiling": "none",
    "shelf 11": "curls",
    "table 12": "streamlines",
    "shelf 13": "curls",
    "table 14": "streamlines",
    "wall 15": "spectrum",
    "wall 16": "spectrum"
   }
  }
 },
 "cascade": [
  {
   "step": "request",
   "type": "noul",
   "instruction": "Is the sentence a request to the room: its visuals, a surface, the music or the effect?",
   "yes": "a request: change, switch, show, start, stop, clear or describe something in the room",
   "no": "not a request: a greeting, chat, a remark, or a question the room cannot answer",
   "criteria_order": [
    "false",
    "true"
   ],
   "rule": "stop unless p(true) >= 0.5"
  },
  {
