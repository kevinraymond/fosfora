<?xml version="1.0" encoding="utf-8"?>
<!-- Native OpenXR app for Meta Quest; see "Android manifest essentials" in
     docs/xr/XR_DESIGN.md. Package id / namespace live in build.gradle.kts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by Meta for every Quest OpenXR app. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true" />

    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Khronos loader: runtime discovery through the OpenXR runtime broker. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
    </queries>

    <application
        android:label="Fosfora VR"
        android:hasCode="false"
        android:allowBackup="false">

        <!-- Value for Meta VR Glasses is not published yet; add it when it is. -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" />

        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:exported="true">
            <!-- NativeActivity loads lib<lib_name>.so: the fosfora-xr cdylib. -->
            <meta-data android:name="android.app.lib_name" android:value="fosfora_xr" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
